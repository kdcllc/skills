    "schema": 1,
    "tokens": {
      "EVALUATOR_AUTO_FAIL_TRIGGERS": "- Unresolved '{{...}}' template token, or a leftover bootstrap comment (an HTML\n  comment opening with the word BOOTSTRAP), in any emitted/instance file.\n- A template token used anywhere under skills/agent-kit/templates/ that is not documented\n  in the placeholder table of skills/agent-kit/SKILL.md.\n- Frontmatter `name:` not matching its folder name (skills) or file name (agents).\n- Hardcoded model IDs anywhere outside the model map (canonical:\n  skills/agent-kit/templates/models.map.md; instance: {{IDE_DIR}}/skills/agent-kit-models.map.md).\n- Instance- or session-specific content leaked INTO canonical templates — the\n  canonical kit under skills/agent-kit/ must stay project-agnostic (product isolation).\n- Template ↔ emitter drift — an emitter under skills/agent-kit/emitters/ referencing\n  files, paths, or keys that no longer exist in templates/.",
      "EXECUTION_LAYERS": "skills/<name>/ (published skills; agent-kit: templates/ → bin/ + emitters/ → reference/harness-matrix.md) → scripts/checks/ + tests/ → docs/ + root README.md / skills.sh.json / marketplace manifests",
      "FULL_TEST_COMMAND": "bash scripts/validate-skills.sh && bash tests/agent-kit/run-all.sh",
      "GROUND_TRUTH_DOC": "docs/agent-kit/research-multi-harness-upgrade.md",
      "PROJECT_NAME": "kdcllc skills",
      "QA_AUTO_FAIL_TRIGGERS": "- An emitted file containing a leftover '{{...}}' template token or bootstrap comment.\n- A broken relative link in README.md or ORCHESTRATION.md (root pointer or an emitted\n  architecture doc instance).\n- An emitted (or canonical) loop.sh failing `bash -n`.",
      "QA_SURFACES": "- **Emitted install artifacts** — the output a /agent-kit run produces in a target project. Evidence: grep output proving zero unresolved tokens/bootstrap comments; frontmatter validation (every `name:` matches its folder/file); `bash -n` output for the emitted loop.sh; link-check output proving relative links in the emitted README/architecture doc resolve.",
      "SETUP_COMMANDS": "# none — git clone, then bash scripts/agent-kit/self-install.sh",
      "STACK_SUMMARY": "A multi-skill Agent Skills pack (kdcllc/skills) distributed through skills.sh, the Claude Code and Cursor plugin marketplaces, and `gh skill`. Every folder under `skills/<name>/` is a published skill (`SKILL.md` + `CHANGELOG.md`, optional `scripts/`, `references/`, `assets/`), versioned on its own via `metadata.version` and released as `<name>/vX.Y.Z` tags. The largest skill is `agent-kit` — the orchestration kit compiler: canonical Claude-format templates under `skills/agent-kit/templates/`, per-harness emitter caveats under `skills/agent-kit/emitters/`, deterministic emitter twins under `skills/agent-kit/bin/`, and a verified harness capability matrix under `skills/agent-kit/reference/`. Maintainer research lives in `docs/agent-kit/`. Executable code is bash + PowerShell twins (emitters, loop drivers, self-install, checks) plus per-skill helper scripts. There is no application runtime — verification is structural: `scripts/validate-skills.sh` (layout, frontmatter, versions, marketplaces, `scripts/checks/*.sh` guards) and the agent-kit suites under `tests/agent-kit/`.",
      "TARGETED_TEST_COMMAND": "grep -n '{{[A-Z_]*}}\\|BOOTSTRAP:' <changed-file>",
      "TEST_FRAMEWORKS": "bash (scripts/validate-skills.sh, scripts/checks/*.sh, tests/agent-kit/**/*.sh)"
    }
  }
}
