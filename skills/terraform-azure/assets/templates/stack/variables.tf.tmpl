variable "organization_name" {
  description = "The organization/project/company identifier used in resource naming"
  type        = string
}

variable "resource" {
  description = "The logical resource name segment used in naming"
  type        = string
}

variable "environment" {
  description = "The environment for which the stack is deployed (e.g., dev, test, prod)"
  type        = string
}

variable "location" {
  description = "The Azure region where resources in this stack will be created"
  type        = string
}

variable "tags" {
  description = "A map of tags to assign to resources in this stack"
  type        = map(string)
  default     = {}
}
